---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getGeneral } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Twelve courses, one kiln, Portland, OR — Ember & Salt" } = Astro.props;
const pageTitle = Astro.url.pathname === '/' ? `${title}` : `${title} | Ember & Salt`;

const generalResult = await getGeneral();
const general = generalResult.data?.general;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="grain">
  <TinaIsland name="header" wrapper={islands.header.wrapper} params={{ path: Astro.url.pathname }}>
    <Header general={general} pathname={Astro.url.pathname} />
  </TinaIsland>
  <slot />
  <TinaIsland name="footer" wrapper={islands.footer.wrapper} params={{ path: Astro.url.pathname }}>
    <Footer />
  </TinaIsland>
  <script is:inline src="/js/lenis.min.js"></script>
  <script is:inline src="/js/app.js" defer></script>
</body>
</html>
