isplay: swap;\n  src: url(/fonts/xn7gYHE41ni1AdIRggexSg.woff2) format('woff2');\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}";
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getConfig } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const configResult = await getConfig();
const config = configResult.data?.config ?? null;

const pageTitle = Astro.url.pathname === '/' ? `${title}` : `${title} | Ember & Salt`;
const metaDescription = description ?? (config as any)?.seo?.description ?? 'Twelve courses, one kiln, Portland, OR — Ember & Salt';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <!-- Both faces that render above the fold, preloaded. The trace showed the
       LCP element is TEXT — "Eat in order. Choose twice." in Fraunces 900 —
       and the font request did not start until 664 ms, so the browser was
       discovering it after first paint. Fraunces 900 is the display face;
       Manrope is a variable file covering the 400/600 body weights. -->
  <link rel="preload" href="/fonts/6NU78FyLNQOQZAnv9bYEvDiIdE9Ea92uemAk_WBq8U_9v0c2Wa0KxC9TeA.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/xn7gYHE41ni1AdIRggexSg.woff2" as="font" type="font/woff2" crossorigin />
  <!-- The two faces that render above the fold, inlined. The stylesheet was a
       hard render blocker: the browser could not paint until it arrived, and
       on Slow 4G that is a 150ms RTT before first paint. These four faces are
       6KB raw and cover every glyph the hero and the body need. -->
  <style set:html={CRITICAL_FONTS} />
  <!-- The remaining 32 faces are non-latin subsets that this page never
       requests. Loaded without blocking so they cannot delay paint. -->
  <link rel="stylesheet" href="/fonts/fonts-rest.css" media="print" onload="this.media='all'" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="grain">
  <TinaIsland name="global" wrapper={islands.global.wrapper} params={{ path: Astro.url.pathname }}>
    <Header config={config} pathname={Astro.url.pathname} />
  </TinaIsland>
  <slot />
  <TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper} params={{ path: Astro.url.pathname }}>
    <Footer config={config} />
  </TinaIsland>
  <script is:inline src="/js/tina-guard.js"></script>
  <script is:inline src="/js/app.js" defer></script>
</body>
</html>
