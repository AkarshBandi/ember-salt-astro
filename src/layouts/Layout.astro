---
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getConfig } from '../lib/tina/data';
import { islands } from '../lib/tina/islands';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const configResult = await getConfig();
const config = configResult.data?.config ?? null;

const pageTitle = Astro.url.pathname === '/' ? `${title}` : `${title} | Ember & Salt`;
const metaDescription = description ?? (config as any)?.seo?.description ?? 'Twelve courses, one kiln, Portland, OR — Ember & Salt';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="grain">
  <TinaIsland name="global" wrapper={islands.global.wrapper} params={{ path: Astro.url.pathname }}>
    <Header config={config} pathname={Astro.url.pathname} />
  </TinaIsland>
  <slot />
  <TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper} params={{ path: Astro.url.pathname }}>
    <Footer config={config} />
  </TinaIsland>
  <script is:inline src="/js/lenis.min.js"></script>
  <script is:inline src="/js/app.js" defer></script>
</body>
</html>
