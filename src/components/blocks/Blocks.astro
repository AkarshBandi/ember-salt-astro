---
import Hero from './Hero.astro';
import Marquee from './Marquee.astro';
import Courses from './Courses.astro';
import Assembly from './Assembly.astro';
import StoryPreview from './StoryPreview.astro';
import MenuHeader from './MenuHeader.astro';
import Letter from './Letter.astro';
import Facts from './Facts.astro';
import Suppliers from './Suppliers.astro';
import Cta from './Cta.astro';
import VisitIntro from './VisitIntro.astro';

const { data } = Astro.props as { data: any };
const blocks = (data?.blocks ?? []).filter(Boolean);
---
{blocks.map((block: any) => {
  const rendered = (() => {
    switch (block?._type) {
      case 'heroBlock':
        return <Hero data={block} />;
      case 'marqueeBlock':
        return <Marquee data={block} />;
      case 'coursesBlock':
        return <Courses data={block} />;
      case 'assemblyBlock':
        return <Assembly data={block} />;
      case 'storyPreviewBlock':
        return <StoryPreview data={block} />;
      case 'menuHeaderBlock':
        return <MenuHeader data={block} />;
      case 'letterBlock':
        return <Letter data={block} />;
      case 'factsBlock':
        return <Facts data={block} />;
      case 'suppliersBlock':
        return <Suppliers data={block} />;
      case 'ctaBlock':
        return <Cta data={block} />;
      case 'visitIntroBlock':
        return <VisitIntro data={block} />;
      default:
        return null;
    }
  })();
  return <div>{rendered}</div>;
})}
