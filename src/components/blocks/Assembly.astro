---
import { tinaField } from '@tinacms/astro/tina-field';

const { data } = Astro.props as { data: any };
const steps = (data?.steps ?? []).filter(Boolean);
---
<section id="assembly" class="cellar" style="padding:var(--space-section) 0;overflow:clip">
  <div class="wrap-wide" style="display:grid;gap:48px;align-items:center" id="assemblyGrid">
    <div style="position:relative;height:440px;border:1px solid rgba(200,169,110,0.3);overflow:hidden" data-tina-field={tinaField(data, 'image')}>
      <img src={data?.image ?? '/images/hero.jpg'} alt="Dish over fire" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
      <div style="position:absolute;inset:0;background:radial-gradient(circle at 50% 62%, transparent 25%, rgba(20,18,16,0.6) 100%)"></div>
      <div id="asmGlow" style="position:absolute;left:48px;right:48px;top:80px;height:96px;border-radius:999px;background:radial-gradient(ellipse at center, rgba(200,169,110,0.45), transparent 70%)"></div>
      <div id="asmPlate" style="position:absolute;left:50%;top:50%;width:208px;height:208px;border-radius:999px;overflow:hidden;border:2px solid var(--brass);transform:translate(-50%,-50%)">
        <img src={data?.plateSrc ?? '/images/dish-fire.jpg'} alt="Signature fire dish" style="width:100%;height:100%;object-fit:cover" data-tina-field={tinaField(data, 'plateSrc')} />
      </div>
      <p id="asmCap" class="eyebrow" style="position:absolute;left:0;right:0;bottom:32px;text-align:center;color:rgba(245,240,232,0.6)" data-tina-field={tinaField(data, 'caption')}>{data?.caption ?? 'Scroll — the plate assembles'}</p>
      <span style="position:absolute;top:24px;left:50%;transform:translateX(-50%)" class="eyebrow miles-pill" data-tina-field={tinaField(data, 'badge')}>{data?.badge ?? 'Course VII'}</span>
    </div>
    <div>
      <div class="rv"><p class="eyebrow" style="color:var(--brass)" data-tina-field={tinaField(data, 'eyebrow')}>{data?.eyebrow ?? 'The fire'}</p></div>
      <div data-tina-field={tinaField(data, 'steps')}>
        {steps.map((s: any) => (
          <div class="rv" style="display:flex;gap:20px;padding:20px 0;border-bottom:1px solid rgba(245,240,232,0.1)">
            <span class="font-display" style="font-style:italic;color:var(--brass);font-size:1.25rem;width:32px;flex-shrink:0">{s?.n}</span>
            <div><h3 class="font-display" style="font-weight:700;font-size:1.25rem">{s?.title}</h3><p style="font-size:14px;color:rgba(245,240,232,0.6);margin-top:4px;line-height:1.6">{s?.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
<style>@media(min-width:900px){#assemblyGrid{grid-template-columns:5fr 3fr !important}}</style>
