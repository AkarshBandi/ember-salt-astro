---
import { tinaField } from '@tinacms/astro/tina-field';

const { data } = Astro.props as { data: any };
const layout = data?.layout ?? 'flight';
const items = (data?.courses ?? []).filter(Boolean);
// Home flight shows a curated 5-plate subset; menu dusk shows all 12.
const flightItems = [items[0], items[1], items[3], items[5], items[10]].filter(Boolean);
---

{layout === 'dusk' ? (
  <section id="dusk" class="linen" style="padding:56px 0 0;color:var(--ink);transition:background-color 0.2s linear">
    <div style="max-width:1000px;margin:0 auto;padding-left:var(--gutter);padding-right:var(--gutter)">
      <div id="duskClockWrap" style="position:fixed;top:70px;left:0;right:0;z-index:40;text-align:center;pointer-events:none;opacity:0;transition:opacity 0.35s;mix-blend-mode:difference;color:#fff">
        <span class="tnum font-display" id="duskClock" style="font-weight:700;font-size:1rem;letter-spacing:0.35em">17:00</span>
      </div>
      <div id="courses" style="margin-top:24px;display:grid" data-tina-field={tinaField(data, 'courses')}>
        {items.map((a: any, i: number) => {
          const isEven = i % 2 === 1;
          const blobClass = `b${i % 3}`;
          return (
            <article class="rv course" data-course={a?.n} data-time={a?.time} style="min-height:82vh;display:flex;flex-direction:column;justify-content:center;padding:48px 0">
              <p class="eyebrow dusk-dim" style="color:var(--brassdeep)" data-tina-field={tinaField(a, 'n')}>Course {a?.n} of twelve</p>
              <div class="course-grid" style="display:grid;gap:36px;align-items:center;margin-top:20px">
                <figure class="rv" style={`margin:0;width:min(320px,70vw);${isEven ? 'order:2;' : ''}`}>
                  <span class={`blob ${blobClass}`} style={`display:block;aspect-ratio:4/5;overflow:hidden;${isEven ? 'transform:rotate(2deg);' : 'transform:rotate(-2deg);'}`}>
                    <img src={a?.img || '/images/dish-fire.jpg'} alt={a?.name} loading="lazy" data-imga={a?.img || '/images/dish-fire.jpg'} data-imgb={a?.imgB || undefined} style="width:100%;height:100%;object-fit:cover;transition:opacity 0.3s" data-tina-field={tinaField(a, 'img')} />
                  </span>
                </figure>
                <div class="course-words">
                  {a?.choice?.length ? (
                    <div style="display:flex;gap:18px;align-items:baseline;flex-wrap:wrap" data-mchoice={a?.n} data-tina-field={tinaField(a, 'choice')}>
                      {a.choice.map((opt: string, j: number) => (
                        <>
                          {j > 0 && <span class="font-display" style="font-style:italic;font-size:clamp(1.3rem,2.5vw,1.8rem)">or</span>}
                          <button class="font-display mpick" data-mopt={opt} aria-pressed="false" style="background:none;border:none;cursor:pointer;font-weight:900;font-size:clamp(2.2rem,5vw,3.8rem);letter-spacing:-0.02em;line-height:1.05;padding:0">{opt}</button>
                        </>
                      ))}
                    </div>
                    <p class="font-display dusk-sense" style="font-style:italic;color:var(--ember);margin-top:8px;font-size:1.15rem" data-tina-field={tinaField(a, 'sense')}>{a?.sense}</p>
                  ) : (
                    <>
                      <h2 class="font-display" style="font-weight:900;font-size:clamp(2.2rem,5vw,3.8rem);letter-spacing:-0.02em;line-height:1.05" data-tina-field={tinaField(a, 'name')}>{a?.name}</h2>
                      <p class="font-display dusk-sense" style="font-style:italic;color:var(--ember);margin-top:8px;font-size:1.15rem" data-tina-field={tinaField(a, 'sense')}>{a?.sense}</p>
                    </>
                  )}
                  {a?.line && <p class="dusk-body" style="margin-top:14px;font-size:16px;line-height:1.65;max-width:30rem" data-tina-field={tinaField(a, 'line')}>{a?.line}</p>}
                </div>
              </div>
            </article>
          );
        })}
      </div>
      <div class="rv" style="text-align:center;padding:96px 0 var(--space-section)">
        <p class="eyebrow dusk-dim" style="color:var(--brassdeep)">Your evening</p>
        <p class="font-display" style="font-size:1.5rem;margin-top:10px" id="menuRecap">Two choices outstanding (0/2). The kiln waits.</p>
        <div style="margin-top:28px;display:flex;flex-wrap:wrap;gap:16px;justify-content:center;align-items:center">
          <span data-magnetic><a href="/visit/" class="btn btn-pour btn-pour-dark eyebrow">Request a table &rarr;</a></span>
          <a href="/" class="eyebrow draw-link" style="padding:14px 8px">Back to the fire</a>
        </div>
      </div>
    </div>
  </section>
  <style>
  #dusk .dusk-body { color: rgba(34,26,18,0.65); transition: color 0.3s; }
  #dusk .dusk-dim { transition: color 0.3s; }
  #dusk.night { color: var(--porcelain); }
  #dusk.night h2, #dusk.night .course-words h2 { color: var(--porcelain); }
  #dusk.night .dusk-body { color: rgba(245,240,232,0.7); }
  #dusk.night .dusk-dim { color: var(--brass) !important; }
  #dusk.night .mpick { color: var(--porcelain); }
  #dusk.night .dusk-sense { color: #E4694E !important; }
  .mpick { color: var(--ink); transition: opacity 0.3s, color 0.3s, text-shadow 0.3s; }
  .mpick.lose { opacity: 0.25; }
  .mpick.win { color: var(--ember) !important; text-shadow: 0 0 32px rgba(179,52,26,0.45); }
  #dusk.night .mpick.win { color: #E4694E !important; text-shadow: 0 0 36px rgba(228,105,78,0.6); }
  .mpick:focus-visible { outline: 2px solid var(--ember); outline-offset: 6px; }
  #duskClock { transition: opacity 0.2s; }
  @media(min-width:860px){.course-grid{grid-template-columns:minmax(0,340px) minmax(0,1fr) !important}}
  .blob { box-shadow: 0 24px 60px rgba(34,26,18,0.28); }
  .blob.b0 { border-radius: 58% 42% 55% 45% / 48% 55% 45% 52%; }
  .blob.b1 { border-radius: 42% 58% 40% 60% / 55% 42% 58% 45%; }
  .blob.b2 { border-radius: 52% 48% 62% 38% / 44% 58% 42% 56%; }
  </style>
) : (
  <section id="menu" class="linen" style="padding:var(--space-section) 0;color:var(--ink)">
    <div class="wrap">
      <div class="rv">
        <p class="eyebrow" style="color:var(--brassdeep)" data-tina-field={tinaField(data, 'eyebrow')}>{data?.eyebrow ?? 'The menu — dinner in five courses'}</p>
        <h2 class="font-display" style="font-weight:900;letter-spacing:-0.02em;max-width:40rem;margin-top:12px;font-size:var(--fs-h2)" data-tina-field={tinaField(data, 'headline')}>{data?.headline ?? 'Five plates land. Scroll to serve.'}</h2>
        <p style="color:rgba(34,26,18,0.62);font-size:15px;margin-top:12px;max-width:36rem" data-tina-field={tinaField(data, 'description')}>{data?.description}</p>
      </div>
      <div id="flight" style="margin-top:48px;display:grid;gap:6vh" data-tina-field={tinaField(data, 'courses')}>
        {flightItems.map((a: any, i: number) => (
          <article class="flight-card rv" data-flight={i} style={`top:calc(88px + ${i * 22}px)`}>
            <div class="flight-photo">
              <img src={a?.img} alt={a?.name} loading="lazy" data-photo-a={a?.img} data-photo-b={a?.imgB || undefined} data-tina-field={tinaField(a, 'img')} />
              <span class="flight-act eyebrow">Course {a?.n} / V</span>
            </div>
            <div class="flight-type">
              <p class="flight-num font-display" aria-hidden="true" style={`-webkit-text-stroke:1.5px ${a?.accent}`}>{a?.numeral}</p>
              <h3 class="font-display" style="font-weight:700;font-size:clamp(1.6rem,3vw,2.4rem);margin-top:4px" data-tina-field={tinaField(a, 'name')}>{a?.name}</h3>
              <p class="font-display" style={`font-style:italic;margin-top:4px;color:${a?.accent}`} data-tina-field={tinaField(a, 'sense')}>{a?.sense}</p>
              <p style="font-size:15px;color:rgba(34,26,18,0.65);margin-top:12px;line-height:1.65;max-width:26rem" data-tina-field={tinaField(a, 'line')}>{a?.line}</p>
              {a?.choice?.length ? (
                <div style="margin-top:18px;display:flex;flex-wrap:wrap;gap:8px" data-choice={a?.n} data-tina-field={tinaField(a, 'choice')}>
                  {a.choice.map((opt: string) => (
                    <button class="chip on-paper" data-opt={opt} aria-pressed="false"><span class="stamp">{opt}</span></button>
                  ))}
                </div>
                <p style="margin-top:10px;font-size:11px;letter-spacing:0.25em;text-transform:uppercase;font-weight:700;color:rgba(34,26,18,0.5)" data-pick-label>Choose one</p>
              ) : (
                <p style="margin-top:18px;font-size:11px;letter-spacing:0.25em;text-transform:uppercase;font-weight:700;color:rgba(34,26,18,0.4)">Ingredients withheld</p>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <div class="linen" style="padding-bottom:40px">
    <hr style="border:none;border-top:1px solid rgba(154,123,69,0.2);margin:0 10%" />
  </div>
)}
