---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig } from '../lib/tina/data';

interface Props {
  config?: CmsConfig | null;
}

const { config } = Astro.props;
const footer = (config as any)?.footer ?? {};
---
<footer id="visit" class="cellar" style="overflow:clip;border-top:1px solid rgba(200,169,110,0.25)">
  <div class="wrap-wide" style="padding-top:var(--space-section);padding-bottom:32px">
    <div class="rv">
      <p class="eyebrow" style="color:var(--brass);text-align:center" data-tina-field={tinaField(footer, 'ctaEyebrow')}>{footer?.ctaEyebrow ?? 'Reservations'}</p>
      <h2 class="font-display" style="font-weight:900;text-align:center;margin-top:12px;font-size:var(--fs-h2)" data-tina-field={tinaField(footer, 'ctaHeadline')}>{footer?.ctaHeadline ?? 'Two seatings nightly.'}</h2>
      <p style="text-align:center;color:rgba(245,240,232,0.55);font-size:14px;margin-top:12px" data-tina-field={tinaField(footer, 'ctaText')}>{footer?.ctaText ?? 'Seventeen hundred hours, and twenty hundred. The diary opens on the first of the month — regulars write, newcomers telephone.'}</p>
      <div style="display:flex;justify-content:center;margin-top:28px">
        <span data-magnetic><a href="/visit/" class="btn btn-pour eyebrow" style="padding:16px 36px">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
          Secure a table</a></span>
      </div>
    </div>
    <div class="rv" style="margin-top:56px">
      <div style="display:flex;align-items:center;gap:16px">
        <span style="display:grid;place-items:center;width:44px;height:44px;border-radius:999px;border:1px solid rgba(200,169,110,0.5);flex-shrink:0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C8A96E" stroke-width="1.5"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
        </span>
        <div>
          <p class="eyebrow" style="color:var(--brass)" data-tina-field={tinaField(footer, 'guestEyebrow')}>{footer?.guestEyebrow ?? 'Guest information'}</p>
          <p class="font-display" style="font-style:italic;font-size:18px;color:rgba(245,240,232,0.85)" data-tina-field={tinaField(footer, 'guestLine')}>{footer?.guestLine ?? 'Taken at the door, remembered at the table.'}</p>
        </div>
      </div>
      <div class="perforation" style="color:var(--brass);margin:28px 0"></div>
      <div style="display:grid;gap:32px" class="foot-grid">
        <div>
          <p class="eyebrow" style="color:var(--brass)" data-tina-field={tinaField(footer, 'serviceEyebrow')}>{footer?.serviceEyebrow ?? '⌾ Service'}</p>
          <div style="margin-top:12px;display:grid;gap:10px;font-size:15px;line-height:1.6;color:rgba(245,240,232,0.8)">
            <p><strong class="font-display" style="color:var(--porcelain)" data-tina-field={tinaField(footer, 'serviceThuSat')}>{footer?.serviceThuSat ?? 'Thu – Sat'}<br />two seatings · 17:00 & 20:00<br /></strong><span class="seats" data-seats="thu-sat-17"></span> · <span class="seats" data-seats="thu-sat-20"></span></p>
            <p><strong class="font-display" style="color:var(--porcelain)" data-tina-field={tinaField(footer, 'serviceSun')}>{footer?.serviceSun ?? 'Sunday'}<br />one long service · 12:00 – 20:00<br /></strong><span class="seats" data-seats="sun"></span></p>
            <p style="color:rgba(245,240,232,0.5)" data-tina-field={tinaField(footer, 'serviceNote')}>{footer?.serviceNote ?? 'Mon – Wed — the kiln rests.'}</p>
          </div>
        </div>
        <div>
          <p class="eyebrow" style="color:var(--brass)" data-tina-field={tinaField(footer, 'roomEyebrow')}>{footer?.roomEyebrow ?? '⌖ The room'}</p>
          <div style="margin-top:12px;display:grid;gap:10px;font-size:15px;line-height:1.6;color:rgba(245,240,232,0.8)">
            <p><strong class="font-display" style="color:var(--porcelain)" data-tina-field={tinaField(footer, 'address1')}>{footer?.address1 ?? '14 Kiln Lane'}</strong><br /><span data-tina-field={tinaField(footer, 'address2')}>{footer?.address2 ?? 'Portland, OR'}</span></p>
            <p style="color:rgba(245,240,232,0.5)" data-tina-field={tinaField(footer, 'roomNote')}>{footer?.roomNote ?? 'Look for the brass flame by the door — three knocks, we answer.'}</p>
          </div>
        </div>
        <div>
          <p class="eyebrow" style="color:var(--brass)">✆ Telephone & post</p>
          <div style="margin-top:12px;display:grid;gap:10px;font-size:15px;line-height:1.6;color:rgba(245,240,232,0.8)">
            <p><strong class="font-display" style="color:var(--porcelain)" data-tina-field={tinaField(footer, 'phone')}>{footer?.phone ?? '+1 503 555 0184'}</strong><br />parties above six — telephone only</p>
            <p style="color:rgba(245,240,232,0.5)" data-tina-field={tinaField(footer, 'email')}>{footer?.email ?? 'hello@emberandsalt.food'}</p>
          </div>
        </div>
      </div>
      <div class="perforation" style="color:var(--brass);margin:28px 0"></div>
      <p style="text-align:center;font-size:13px;color:rgba(245,240,232,0.55)" data-tina-field={tinaField(footer, 'legalNote')}>{footer?.legalNote ?? 'Good to know — allergens told ahead are cooked around · smart dress, no ceremony · the whole table takes the tasting.'}</p>
    </div>
    <div style="margin-top:40px" aria-hidden="true"><p class="giant-outline" data-tina-field={tinaField(footer, 'giantText')}>{footer?.giantText ?? 'EMBER'}</p></div>
    <div style="display:flex;flex-direction:column;gap:8px;justify-content:space-between;padding-top:24px;margin-top:24px;border-top:1px solid rgba(245,240,232,0.1);font-size:11px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(245,240,232,0.4)" class="foot-base">
      <span data-tina-field={tinaField(footer, 'copyright')}>{footer?.copyright ?? '© 2026 Ember & Salt — portfolio demo · photos Pexels'}</span>
      <span data-tina-field={tinaField(footer, 'hoursNote')}>{footer?.hoursNote ?? 'Thu – Sat · Sun midday'}</span>
    </div>
  </div>
</footer>
<style>@media(min-width:640px){.foot-grid{grid-template-columns:repeat(3,1fr)}.foot-base{flex-direction:row !important}}</style>
