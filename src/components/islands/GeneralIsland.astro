---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsGeneral } from '../../lib/tina/data';

interface Props {
  general?: CmsGeneral | null;
}

const { general } = Astro.props;
const navLinks = general?.nav_links ?? [];
---

<div>
  {navLinks.map((link) => (
    <span data-tina-field={tinaField(link, 'label')}>{link.label}</span>
  ))}
</div>
