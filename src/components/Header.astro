---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig } from '../lib/tina/data';

interface Props {
  config?: CmsConfig | null;
  pathname?: string;
}

const { config, pathname = '/' } = Astro.props;

const navLinks = (config as any)?.nav?.length
  ? (config as any).nav.map((l: any) => ({ name: l?.title ?? '', href: l?.link ?? '/' }))
  : [
      { name: 'Menu', href: '/menu/' },
      { name: 'Our Story', href: '/story/' },
      { name: 'Journal', href: '/journal/' },
      { name: 'Reservations', href: '/visit/' },
    ];

const header = (config as any)?.header ?? {};
const wordmark = header.wordmark ?? 'EMBER';
const wordmarkJoiner = header.wordmarkJoiner ?? '&';
const wordmarkEnd = header.wordmarkEnd ?? 'SALT';
const ctaLabel = header.ctaLabel ?? (config as any)?.headerCtaLabel ?? 'Secure a Table';
const ctaLabelShort = header.ctaLabelShort ?? 'Reserve';
const ctaLink = header.ctaLink ?? '/visit/';
const menuButtonLabel = header.menuButtonLabel ?? 'Open menu';
---
<div class="progress-line" id="progressLine"></div>
<header class="site-header clear" id="siteHeader">
  <div class="wrap-wide header-inner">
    <a href="/" class="brand">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
      <span><span data-tina-field={tinaField(header as any, 'wordmark')}>{wordmark}</span> <em data-tina-field={tinaField(header as any, 'wordmarkJoiner')}>{wordmarkJoiner}</em> <span data-tina-field={tinaField(header as any, 'wordmarkEnd')}>{wordmarkEnd}</span></span>
    </a>
    <nav class="main-nav" aria-label="Primary" data-tina-field={tinaField(config as any, 'nav')}>
      {navLinks.map((link) => {
        const isActive = pathname === link.href;
        return <a href={link.href} class="eyebrow draw-link" {...(isActive ? { 'aria-current': 'page', style: 'color:var(--brass)' } : {})}>{link.name}</a>;
      })}
    </nav>
    <div style="display:flex;align-items:center;gap:12px">
      <a href={ctaLink} class="btn btn-pour eyebrow" style="padding:10px 24px" data-tina-field={tinaField(header as any, 'ctaLink')}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 2v7c0 1.1.9 2 2 2h4c1.1 0 2-.9 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
        <span class="hide-sm" data-tina-field={tinaField(header as any, 'ctaLabel')}>{ctaLabel}</span><span class="show-sm" data-tina-field={tinaField(header as any, 'ctaLabelShort')}>{ctaLabelShort}</span>
      </a>
      <button class="menu-btn" id="menuBtn" aria-label={menuButtonLabel} data-tina-field={tinaField(header as any, 'menuButtonLabel')} aria-expanded="false">
        <svg id="menuIcoOpen" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        <svg id="menuIcoClose" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="display:none"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>
<nav class="mobile-nav cellar" id="mobileNav" aria-label="Mobile">
  <p class="eyebrow" style="color:var(--brass);margin-bottom:24px">Ember & Salt</p>
  {navLinks.map((link, i) => (
    <a class="big" href={link.href}><span style="font-size:14px;color:var(--brass);font-family:var(--font-body)">0{i + 1}</span> {link.name}</a>
  ))}
  <p class="font-display" style="font-style:italic;font-size:1.25rem;color:rgba(245,240,232,0.6);margin-top:40px">Thu – Sat · 17:00 – 23:00</p>
</nav>
<style>.hide-sm{display:none}.show-sm{display:inline}@media(min-width:640px){.hide-sm{display:inline}.show-sm{display:none}}</style>
