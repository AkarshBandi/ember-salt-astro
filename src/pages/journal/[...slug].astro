---
import Layout from '../../layouts/Layout.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import BlogBody from '../../components/islands/BlogBody.astro';
import { getJournal } from '../../lib/tina/data';
import { islands } from '../../lib/tina/islands';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/journal/');

const journalResult = await getJournal(slug);
const journal = journalResult.data?.journal;
if (!journal) return new Response('Not Found', { status: 404 });
---

<Layout title={journal?.title ?? 'Journal'}>
  <TinaIsland name="journal" wrapper={islands.journal.wrapper} params={{ slug }} primary>
    <BlogBody data={journal} />
  </TinaIsland>
</Layout>
