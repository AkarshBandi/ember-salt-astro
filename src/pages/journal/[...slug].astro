---
// Prerendered. The draft version lives at /preview/journal/*.
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import BlogBody from '../../components/islands/BlogBody.astro';
import { getJournal } from '../../lib/data';
import { listJournalSlugs } from '../../sanity/lib/slugs';

export async function getStaticPaths() {
  const slugs = await listJournalSlugs();
  return slugs.map((slug) => ({ params: { slug }, props: {} }));
}

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/journal/');

const journal = (await getJournal(slug, false)).data?.journal;
if (!journal) return new Response('Not Found', { status: 404 });
---

<Layout title={journal?.title ?? 'Journal'}>
  <BlogBody data={journal} />
</Layout>