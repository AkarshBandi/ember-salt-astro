---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Story">
<main class="linen" style="color:var(--ink)">
  <section style="padding:112px 0 64px;max-width:760px;margin:0 auto;padding-left:var(--gutter);padding-right:var(--gutter)">
    <p class="eyebrow rv" style="color:var(--brassdeep)">Story — a letter from the kitchen</p>
    <h1 class="font-display rv" style="font-weight:900;letter-spacing:-0.02em;margin-top:12px;font-size:var(--fs-h2)">Dear hungry stranger,</h1>
    <div class="rv letter" style="margin-top:32px">
      <span class="margin-note">written between services</span>
      <p class="font-display dropcap" style="font-size:1.15rem;line-height:1.9">Eleven years cooking for other people teaches you one thing: the menu is a guess and the fire is the answer. Copenhagen taught me fermentation schedules. San Sebastián taught me that a room goes quiet when the plate is right. A smokehouse outside Austin — pitmaster Ray, who spoke only in temperatures — taught me that oak at four hundred degrees forgives almost everything except rushing.</p>
      <p class="font-display" style="font-size:1.15rem;line-height:1.9;margin-top:24px">So in 2019 I signed a lease on a room nobody wanted on Kiln Lane, installed one oak kiln where the bar used to be, and put fourteen chairs around it. March that year I burnt the bread course two services running. Nobody complained. One table applauded. The kiln stays. The chairs stay. Everything else — the farms, the crocks, the pairings — gets renegotiated every morning.</p>
      <p class="font-display" style="font-style:italic;font-size:1.25rem;margin-top:32px">— Mara</p>
    </div>
  </section>
  <section style="max-width:760px;margin:0 auto;padding:0 var(--gutter) 64px">
    <p class="eyebrow rv" style="color:var(--brassdeep)">What you are booking — the room in facts</p>
    <div class="rv" style="margin-top:20px;display:flex;flex-wrap:wrap;gap:40px 56px">
      {[
        { n: "14", t: "seats around one kiln" },
        { n: "12", t: "courses, about three hours" },
        { n: "40", t: "miles — nothing travels further" },
        { n: "14", t: "crocks aging on the back wall" },
      ].map((f) => (
        <div><p class="tnum font-display" style="font-weight:900;font-size:clamp(2.6rem,5vw,3.6rem);line-height:1;color:transparent;-webkit-text-stroke:1.5px #9A7B45">{f.n}</p><p style="font-size:14px;color:rgba(34,26,18,0.65);margin-top:6px">{f.t}</p></div>
      ))}
    </div>
  </section>
  <div style="max-width:1240px;margin:0 auto;padding:0 var(--gutter)">
    <hr style="border:none;border-top:1px solid rgba(154,123,69,0.2);margin:0" />
  </div>
  <section style="padding:64px 0 var(--space-section)">
    <div style="max-width:1240px;margin:0 auto;padding:0 var(--gutter);display:flex;align-items:end;justify-content:space-between;gap:24px">
      <div>
        <p class="eyebrow rv" style="color:var(--brassdeep)">The suppliers — five of forty miles</p>
        <h2 class="font-display rv" style="font-weight:900;margin-top:12px;font-size:var(--fs-h3)">Voted in, never overruled.</h2>
      </div>
      <div class="rv" style="display:flex;gap:8px;flex-shrink:0">
        <button id="supPrev" aria-label="Previous supplier" style="width:48px;height:48px;border-radius:999px;border:1px solid rgba(34,26,18,0.3);background:none;cursor:pointer;font-size:1.2rem;color:var(--ink)">&larr;</button>
        <button id="supNext" aria-label="Next supplier" style="width:48px;height:48px;border-radius:999px;border:1px solid rgba(34,26,18,0.3);background:none;cursor:pointer;font-size:1.2rem;color:var(--ink)">&rarr;</button>
      </div>
    </div>
    <div id="supStrip" tabindex="0" role="region" aria-label="Suppliers, scroll sideways" data-lenis-prevent style="margin-top:32px;display:flex;gap:clamp(20px,4vw,48px);overflow-x:auto;scroll-snap-type:x mandatory;padding:8px var(--gutter) 32px;scrollbar-width:none">
      {[
        { n: "Sauvie Island Greens", d: "Picked at dawn, dead by dinner.", img: "/images/dish-bowl.jpg" },
        { n: "Willamette Pasture", d: "The land half of Act IV.", img: "/images/dish-burger.jpg" },
        { n: "Hood River Orchards", d: "Stone fruit for the sweet smoke.", img: "/images/dish-pancake.jpg" },
        { n: "Roof Hives", d: "Hot honey, eleven metres up.", img: "/images/dish-table.jpg" },
        { n: "Crock Seven", d: "Day-fourteen kraut lives here.", img: "/images/act-ferment.jpg" },
      ].map((f, i) => (
        <figure class="rv" style={`flex:0 0 min(76vw,360px);scroll-snap-align:center;margin:0`}>
          <span style={`display:block;aspect-ratio:1/1;border-radius:999px;padding:16px;background:#FFFFFF;box-shadow:0 24px 60px rgba(34,26,18,0.25);${i % 2 === 1 ? 'transform:rotate(2deg);' : 'transform:rotate(-2deg);'}`}>
            <span style="display:block;width:100%;height:100%;border-radius:999px;overflow:hidden;border:1px solid rgba(154,123,69,0.55);box-shadow:inset 0 0 0 8px #fff,inset 0 14px 34px rgba(20,18,16,0.3)">
              <img src={f.img} alt={f.n} loading="lazy" draggable="false" style="width:100%;height:100%;object-fit:cover;pointer-events:none" />
            </span>
          </span>
          <figcaption style="padding:20px 8px 0"><p class="font-display" style="font-weight:900;font-size:clamp(1.5rem,2.5vw,2rem);letter-spacing:-0.01em">{f.n}</p><p class="font-display" style="font-style:italic;font-size:15px;color:var(--ember);margin-top:4px">{f.d}</p></figcaption>
        </figure>
      ))}
    </div>
    <p class="eyebrow" style="text-align:center;color:rgba(34,26,18,0.4)">Drag sideways &rarr;</p>
  </section>
  <section style="max-width:760px;margin:0 auto;padding:0 var(--gutter) var(--space-section);text-align:center">
    <div class="rv">
      <p class="eyebrow" style="color:var(--brassdeep)">If that sounds like dinner to you</p>
      <p class="font-display" style="font-size:1.4rem;margin-top:10px">Two seatings nightly. Fourteen seats. <span class="seats" data-seats-next></span></p>
      <div style="margin-top:24px;display:flex;flex-wrap:wrap;gap:16px;justify-content:center;align-items:center">
        <span data-magnetic><a href="/visit/" class="btn btn-pour btn-pour-dark eyebrow">Request a table &rarr;</a></span>
        <a href="/menu/" class="eyebrow draw-link" style="padding:14px 8px">Read the menu first</a>
      </div>
    </div>
  </section>
</main>
</Layout>
